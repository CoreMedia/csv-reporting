    "@coremedia/studio-client.ext.library-services-toolkit": "^2506.0.0",
    "@coremedia/studio-client.ext.toast-components": "^2506.0.0",
    "@coremedia/studio-client.ext.ui-components": "^2506.0.0",
    "@coremedia/studio-client.job-models": "^2506.0.0",
    "@coremedia/studio-client.main.editor-components": "^2506.0.0",
